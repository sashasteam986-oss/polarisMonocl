  }
  .lib-cards.list .lib-art svg { width: 42%; height: 42%; }
  .lib-cards.list .lib-art-artist { font-size: 20px; }
  .lib-cards.list .lib-card:hover .lib-art { transform: none; box-shadow: none; }
  .lib-cards.list .lib-card-name { margin-top: 0; }
