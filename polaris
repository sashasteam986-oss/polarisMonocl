    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .lib-card-sub { margin-top: 3px; font-size: 12.5px; color: var(--muted); }

  .lib-cards.list { display: flex; flex-direction: column; gap: 4px; max-width: 720px; }
  .lib-cards.list .lib-card {
    display: flex; align-items: center; gap: 13px;
    padding: 7px 9px; border-radius: 10px; transition: background .14s;
  }
  .lib-cards.list .lib-card:hover { background: rgba(255,255,255,.07); }
  .lib-cards.list .lib-art {
