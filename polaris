    letter-spacing: -.05em; color: #fff;
    text-shadow: 0 2px 12px rgba(0,0,0,.3);
  }
  .mix-name { margin-top: 10px; font-size: 14px; font-weight: 700; }
  .mix-sub {
    margin-top: 3px; font-size: 12.5px; color: var(--muted);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  .section-title {
    display: flex; align-items: center; gap: 10px;
    font-size: clamp(18px, 1.7vw, 23px); font-weight: 800;
    letter-spacing: -.02em;
  }
  .section-title svg { width: 20px; height: 20px; }

  .section-head {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; max-width: 1080px; margin: 30px 0 12px;
  }
  .section-head .section-title { margin: 0; }

  .add-btn {
    display: inline-flex; align-items: center; gap: 7px; flex: 0 0 auto;
    height: 34px; padding: 0 13px;
    border: 1px solid rgba(255,255,255,.16); border-radius: 9px;
    background: rgba(255,255,255,.06); color: #fff;
    font-size: 13px; font-weight: 600; cursor: pointer;
    transition: background .15s, border-color .15s;
  }
  .add-btn:hover { background: rgba(255,255,255,.13); border-color: rgba(255,255,255,.3); }

  .lib-hint {
    max-width: 1080px; margin-top: 4px; padding: 16px 18px;
    border: 1px dashed rgba(255,255,255,.16); border-radius: 12px;
    color: rgba(255,255,255,.5); font-size: 13.5px; line-height: 1.5;
  }

  /* ------------------------------ library screen --------------------------- */
  .lib-head {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 16px; flex-wrap: wrap; margin: 2px 0 16px;
  }
  .lib-title {
    margin: 0; font-size: clamp(26px, 2.5vw, 33px); font-weight: 800; letter-spacing: -.03em;
  }
  .lib-tools { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .lib-search {
    display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 12px;
    border-radius: 9px; background: rgba(255,255,255,.07); color: rgba(255,255,255,.55);
    cursor: text;
