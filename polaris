  function checkWebUpdate() {
    if (location.protocol !== 'http:' && location.protocol !== 'https:') {
      setWebStatus('Обновления работают только у версии, открытой по ссылке.', false);
      return;
    }

    setWebStatus('Проверяю обновления…', true);

    fetch(location.pathname + '?polaris=' + Date.now(), { method: 'HEAD', cache: 'no-store' })
      .then(function (res) {
        if (!res.ok) throw new Error('http ' + res.status);

        var remote = res.headers.get('last-modified');
        var loaded = document.lastModified;
        if (!remote || !loaded) {
          setWebStatus('Сервер не сообщил дату версии. Попробуйте позже.', false);
          return;
        }

        var remoteAt = Date.parse(remote);
        var loadedAt = Date.parse(loaded);
        if (!remoteAt || !loadedAt) {
          setWebStatus('Не удалось сравнить версии. Попробуйте позже.', false);
          return;
        }

        if (remoteAt <= loadedAt + 1500) {
          var label = buildDateLabel();
          setWebStatus('У вас последняя версия.' + (label ? ' Сборка от ' + label + '.' : ''), false);
          return;
        }

        setWebStatus('Найдена новая версия. Перезагружаю…', true);

        // Одна попытка на версию в рамках вкладки — без циклов перезагрузки
        var guard = 'polaris.upd.' + remoteAt;
        try {
          if (sessionStorage.getItem(guard)) {
            setWebStatus('Новая версия уже загружалась. Обновите страницу вручную (Ctrl + F5).', false);
            return;
          }
          sessionStorage.setItem(guard, '1');
        } catch (e) {}

        setTimeout(function () {
          location.replace(location.pathname + '?v=' + remoteAt + location.hash);
        }, 700);
      })
      .catch(function () {
        setWebStatus('Не удалось проверить обновления. Проверьте интернет и попробуйте ещё раз.', false);
      });
  }

