  function lyricKey(text) {
    return String(text || '')
      .toLowerCase()
      .replace(/ё/g, 'е')
      .replace(/#\S+/g, ' ')
      .replace(/[^a-zа-я0-9\s]/gi, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function lyricWords(text) {
    var key = lyricKey(text);
    return key ? key.split(' ') : [];
  }

  function lyricOverlap(want, have) {
    var wanted = lyricWords(want);
    var actual = lyricWords(have);
    if (!wanted.length || !actual.length) return 0;
    var hits = 0;
    for (var i = 0; i < wanted.length; i++) {
      if (actual.indexOf(wanted[i]) >= 0) hits += 1;
    }
    return hits / wanted.length;
  }

  // Разбираем «NEMIGA - Маяк (slowed)» на название и список исполнителей
  function lyricMeta(artist, title) {
    var raw = String(title || '');
    var artists = [];

    function addArtists(text) {
      String(text || '')
        .split(/\s*(?:&|,|\+|\/|\bft\.?\b|\bfeat\.?\b|\bfeaturing\b)\s*/i)
        .forEach(function (part) {
          var key = lyricKey(part);
          if (key && artists.indexOf(key) < 0) artists.push(key);
        });
    }

    addArtists(artist);

    var main = raw;
    var dash = raw.split(/\s+[—–-]\s+/);
    if (dash.length >= 2) {
      addArtists(dash[0]);
      main = dash.slice(1).join(' - ');
    }

    main = main.replace(/\([^)]*$|\([^)]*\)|\[[^\]]*\]/g, ' ');
    main = main.replace(/\s+w\/\s+.*$/i, ' ');
    // Хвосты вроде «prod. …», «slowed», «mp3» к названию песни не относятся
    main = main.replace(/\b(prod\.?|slowed|reverb|speed\s*up|sped\s*up)\b.*$/i, ' ');
    main = main.replace(/\b(mp3|m4a|wav|flac)\b/gi, ' ');

    var parts = main.split(/\s*(?:\+|,|&|\bft\.?\b|\bfeat\.?\b|\bfeaturing\b)\s*/i);
    parts.slice(1).forEach(addArtists);

    return {
      title: lyricKey(parts[0] || ''),
      rawTitle: raw,
      artists: artists
    };
  }

  function lyricQueries(artist, title) {
    var meta = lyricMeta(artist, title);
    var list = [
      (lyricKey(artist) + ' ' + meta.title).trim(),
      meta.title,
      lyricKey(String(title || '').replace(/\([^)]*$|\([^)]*\)|\[[^\]]*\]/g, ' '))
    ];

    var seen = {};
    return list.filter(function (query) {
      if (!query || seen[query]) return false;
      seen[query] = 1;
      return true;
    });
  }

  function isAlternativeVersion(name) {
    return /\b(remix|rmx|cover|slowed|reverb|sped\s*up|speed\s*up|nightcore|instrumental)\b/i
      .test(String(name || ''));
  }

  // Поле duration в LRCLIB часто врёт (у одной и той же записи бывает 16, 149, 219 с),
  // поэтому длину текста считаем по последней метке в самих строках
  function lrcSpan(raw) {
    var tag = /\[(\d{1,3}):(\d{1,2})(?:[.:](\d{1,3}))?\]/g;
    var text = String(raw || '');
    var last = 0;
    var match = tag.exec(text);
    while (match) {
      var value = Number(match[1]) * 60 + Number(match[2]);
      if (match[3]) value += Number('0.' + match[3]);
      if (value > last) last = value;
      match = tag.exec(text);
    }
    return last;
  }

  function pickLyrics(pool, meta, duration) {
    var best = null;
    var bestScore = -Infinity;
    var knownArtist = meta.artists.length > 0;
    var trackLength = Number(duration) || 0;

    pool.forEach(function (item) {
      if (!item || !item.syncedLyrics || item.instrumental) return;

      var titleScore = lyricOverlap(meta.title, item.trackName);
      var artistScore = 0;
      meta.artists.forEach(function (name) {
        var score = lyricOverlap(name, item.artistName);
        if (score > artistScore) artistScore = score;
      });

      // Берём только полное совпадение названия и хотя бы одного исполнителя.
      // Иначе на «Подиум» легко получить текст совсем другой песни.
      if (titleScore < 0.999) return;
      if (knownArtist && artistScore < 0.999) return;

      var span = lrcSpan(item.syncedLyrics);
      if (span < 20) return;

      var factor = 1;
      if (trackLength > 30) {
        factor = trackLength / span;
        // Текст от другой (более длинной/короткой) версии не растягиваем наугад
        if (factor < 0.7 || factor > 1.45) return;
        // Без исполнителя (локальный файл) доверяем только почти точной длине
        if (!knownArtist && (factor < 0.85 || factor > 1.18)) return;
      }

      var score = 3 + titleScore + artistScore;
      if (trackLength > 30) score += (1 - Math.min(1, Math.abs(factor - 1))) * 2;

      if (isAlternativeVersion(item.trackName) && !isAlternativeVersion(meta.rawTitle)) score -= 1.5;

      if (score > bestScore) {
        bestScore = score;
        best = item;
      }
    });

    if (!best) return null;
    return scaleLrc(best.syncedLyrics, lyricScale(lrcSpan(best.syncedLyrics), trackLength));
  }

  // Slowed/sped-up версии длятся иначе — растягиваем тайминги под нашу длительность.
  // Небольшие расхождения не трогаем: текст часто просто заканчивается раньше трека.
  function lyricScale(span, duration) {
    var original = Number(span) || 0;
    var current = Number(duration) || 0;
    if (original < 20 || !current) return 1;
    var factor = current / original;
    if (factor < 0.7 || factor > 1.45) return 1;
    if (factor > 0.85 && factor < 1.18) return 1;
    return factor;
  }

  function scaleLrc(raw, factor) {
    if (!factor || Math.abs(factor - 1) < 0.001) return raw;

    var tag = /\[(\d{1,3}):(\d{1,2})(?:[.:](\d{1,3}))?\]/g;
    return String(raw || '').replace(tag, function (whole, mm, ss, fraction) {
      var value = Number(mm) * 60 + Number(ss);
      if (fraction) value += Number('0.' + fraction);
      value *= factor;

      var hundredths = Math.round(value * 100);
      var minutes = Math.floor(hundredths / 6000);
      var seconds = (hundredths - minutes * 6000) / 100;
      var sec = (seconds < 10 ? '0' : '') + seconds.toFixed(2);
      var min = (minutes < 10 ? '0' : '') + minutes;
      return '[' + min + ':' + sec + ']';
    });
  }

  function searchLyrics(artist, title, duration) {
    var meta = lyricMeta(artist, title);
    if (!meta.title) return Promise.resolve(null);

    var queries = lyricQueries(artist, title);
    var pool = [];
    var seen = {};
    var index = 0;

    function step() {
      if (index >= queries.length) return Promise.resolve(pickLyrics(pool, meta, duration));

      var query = queries[index++];
      return fetch('https://lrclib.net/api/search?q=' + encodeURIComponent(query))
        .then(function (response) { return response.ok ? response.json() : null; })
        .then(function (list) {
          if (Array.isArray(list)) {
            list.forEach(function (item) {
              if (!item) return;
              var key = String(item.id || '') + '|' + String(item.trackName) + '|' + String(item.artistName);
              if (seen[key]) return;
              seen[key] = 1;
              pool.push(item);
            });
          }
          return step();
        })
        .catch(function () { return step(); });
    }

    return step();
  }

