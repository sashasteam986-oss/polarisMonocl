  .lib-tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 20px; }
  .lib-tab {
    height: 32px; padding: 0 15px; border: none; border-radius: 8px;
    background: rgba(255,255,255,.08); color: rgba(255,255,255,.75);
