<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Polaris Mono — Весь этот мир</title>
<link rel="preconnect" href="https://polaris-proxy.sashasteam986.workers.dev" crossorigin>
<link rel="preconnect" href="https://api-v2.soundcloud.com" crossorigin>
<link rel="preconnect" href="https://i1.sndcdn.com">
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="preconnect" href="https://jqruaqzdzbesnfvtgxjp.supabase.co" crossorigin>
<style>
  :root {
    color-scheme: dark;
    --muted: rgba(255,255,255,.58);
    --dim: rgba(255,255,255,.3);
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0;
    background: #141311;
    color: #fff;
    font-family: "Segoe UI Variable Display", "Segoe UI", Inter, system-ui, -apple-system, sans-serif;
    overflow: hidden;
    -webkit-font-smoothing: antialiased;
  }
  button { font-family: inherit; }
  .hidden { display: none !important; }

  .app { position: relative; display: flex; flex-direction: column; height: 100vh; width: 100vw; overflow: hidden; }

  .bg {
    position: absolute; inset: -90px;
    background-size: cover; background-position: center;
    background-color: #2b2824;
    filter: blur(90px) saturate(1.25) brightness(.62);
    transform: scale(1.2);
  }
  .bg-overlay {
    position: absolute; inset: 0;
    background:
      radial-gradient(circle at 32% 38%, rgba(0,0,0,0), rgba(0,0,0,.46) 82%),
      linear-gradient(180deg, rgba(0,0,0,.12), rgba(0,0,0,.26));
  }

  .titlebar {
    position: relative; z-index: 5;
    height: 48px; flex: 0 0 48px;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 14px;
  }
  .tb-side { display: flex; align-items: center; gap: 8px; min-width: 150px; }
  .tb-side.right { justify-content: flex-end; }
  .tb-btn {
    display: inline-flex; align-items: center; gap: 7px;
    height: 28px; padding: 0 11px;
    border: 1px solid rgba(255,255,255,.1); border-radius: 8px;
    background: rgba(20,19,17,.5); color: rgba(255,255,255,.78);
    font-size: 12px; font-weight: 600;
    cursor: pointer; backdrop-filter: blur(10px);
    transition: background .15s, color .15s;
  }
  .tb-btn:hover { background: rgba(255,255,255,.12); color: #fff; }

  .content {
    position: relative; z-index: 2;
    height: 100%; min-height: 0;
    display: grid;
    grid-template-columns: minmax(280px, min(560px, 40vw)) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 92px);
    padding: 6px clamp(22px, 4vw, 64px) 16px;
  }

  .player {
    display: flex; flex-direction: column; justify-content: center;
    width: 100%; max-width: 620px; height: 100%; justify-self: center;
    min-height: 0;
  }
  .cover {
    position: relative; flex: 0 1 auto; width: auto; height: 100%; max-height: 100%;
    max-width: 100%; aspect-ratio: 1/1; align-self: center; min-height: 0;
    border-radius: 12px; overflow: hidden;
    background: linear-gradient(140deg, #3a3733, #1b1a18);
    box-shadow: 0 26px 60px rgba(0,0,0,.48), 0 2px 8px rgba(0,0,0,.3);
  }
  .cover img { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* --------------------------- «Сейчас играет» --------------------------- */
  .note-defs { position: absolute; width: 0; height: 0; overflow: hidden; }

  .now-playing {
    display: flex; align-items: center; gap: 12px;
    margin: 0 2px clamp(12px, 1.9vh, 20px);
    animation: np-in .55s cubic-bezier(.22, 1, .36, 1) both;
  }
  @keyframes np-in {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: none; }
  }

  .np-badge {
    position: relative; flex: 0 0 auto;
    width: 38px; height: 38px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; gap: 3px;
    background:
      radial-gradient(120% 120% at 30% 18%, rgba(255,255,255,.13), rgba(255,255,255,.03) 68%),
      rgba(255,255,255,.03);
    border: 1px solid rgba(255,255,255,.12);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.1), 0 8px 22px rgba(0,0,0,.32);
  }
  .np-badge i {
    display: block; width: 3px; height: 8px; border-radius: 2px;
    background: linear-gradient(180deg, #ffe9cf, #e8c69c);
    transform-origin: 50% 100%;
    opacity: .7;
    transition: transform .4s cubic-bezier(.22, 1, .36, 1), opacity .4s ease;
  }
  .np-badge i:nth-child(2) { height: 13px; }
  .np-badge i:nth-child(3) { height: 10px; }
  body.is-playing .np-badge i { opacity: 1; animation: np-eq 1.15s ease-in-out infinite; }
  body.is-playing .np-badge i:nth-child(2) { animation-delay: -.38s; }
  body.is-playing .np-badge i:nth-child(3) { animation-delay: -.72s; }
  @keyframes np-eq {
    0%, 100% { transform: scaleY(.5); }
    50% { transform: scaleY(1); }
  }

  .np-meta { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .np-label {
    font-size: 10px; font-weight: 700; letter-spacing: .2em;
    text-transform: uppercase; color: rgba(255,255,255,.46);
  }
  .np-title {
    font-size: 15px; font-weight: 650; color: rgba(255,255,255,.92);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .np-title.swap { animation: np-swap .5s cubic-bezier(.22, 1, .36, 1); }
  @keyframes np-swap {
    from { opacity: 0; transform: translateY(7px); filter: blur(3px); }
    to { opacity: 1; transform: none; filter: none; }
  }

  .track-head {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 22px; margin-top: clamp(14px, 2vh, 22px);
  }
  .track-meta { min-width: 0; }
  .track-title {
    font-size: clamp(27px, 2.3vw, 38px); font-weight: 700; line-height: 1.18;
    letter-spacing: -.02em;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .track-artist {
    display: flex; align-items: center; gap: 12px;
    margin-top: 9px; font-size: 19px; color: var(--muted); min-width: 0;
  }
  .track-artist .avatar {
    flex: 0 0 auto; width: 32px; height: 32px; border-radius: 50%;
    object-fit: cover; background: rgba(255,255,255,.16);
  }
  .track-artist .artist-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .icon-btn {
    flex: 0 0 auto; width: 50px; height: 50px;
    display: flex; align-items: center; justify-content: center;
    border: none; border-radius: 13px;
    background: rgba(255,255,255,.13); color: #fff;
    cursor: pointer; transition: background .15s, transform .12s;
  }
  .icon-btn:hover { background: rgba(255,255,255,.22); }
  .icon-btn:active { transform: scale(.94); }
  #likeBtn svg .check { opacity: 0; transition: opacity .16s ease; }
  #likeBtn svg .plus { opacity: 1; transition: opacity .16s ease; }
  #likeBtn.active { background: #fff; color: #121212; }
  #likeBtn.active svg .check { opacity: 1; }
  #likeBtn.active svg .plus { opacity: 0; }

  .progress { display: flex; flex-direction: column; gap: 8px; margin-top: clamp(12px, 2.2vh, 24px); }
  .time-row { display: flex; justify-content: space-between; }
  .time { font-size: 16px; color: rgba(255,255,255,.62); font-variant-numeric: tabular-nums; }

  input[type="range"].slider {
    -webkit-appearance: none; appearance: none;
    width: 100%; height: 16px; margin: 0; background: transparent; cursor: pointer;
  }
  input[type="range"].slider::-webkit-slider-runnable-track {
    height: 4px; border-radius: 2px;
    background: linear-gradient(to right, rgba(255,255,255,.94) var(--fill, 0%), rgba(255,255,255,.18) var(--fill, 0%));
  }
  input[type="range"].slider::-moz-range-track { height: 4px; border-radius: 2px; background: rgba(255,255,255,.18); }
  input[type="range"].slider::-moz-range-progress { height: 4px; border-radius: 2px; background: rgba(255,255,255,.94); }
  input[type="range"].slider::-webkit-slider-thumb {
    -webkit-appearance: none; width: 12px; height: 12px; margin-top: -4px;
    border-radius: 50%; background: #fff; opacity: 0; transition: opacity .15s;
  }
  input[type="range"].slider:hover::-webkit-slider-thumb,
  input[type="range"].slider:active::-webkit-slider-thumb { opacity: 1; }
  input[type="range"].slider.thin::-webkit-slider-runnable-track { height: 3px; }
  input[type="range"].slider.thin::-webkit-slider-thumb { width: 10px; height: 10px; margin-top: -3.5px; }

  .seek-wrap { position: relative; display: flex; align-items: center; }
  .seek-tip {
    position: absolute; top: -36px; left: 0;
    transform: translate(-50%, 4px);
    padding: 4px 10px; border-radius: 8px;
    background: rgba(18,17,16,.92); border: 1px solid rgba(255,255,255,.12);
    font-size: 16px; color: #fff; font-variant-numeric: tabular-nums;
    opacity: 0; pointer-events: none; white-space: nowrap;
    transition: opacity .15s ease, transform .15s ease;
    z-index: 5;
  }
  .progress.adjusting .seek-tip { opacity: 1; transform: translate(-50%, 0); }

  input[type="range"].seek-slider { height: 32px; }
  input[type="range"].seek-slider::-webkit-slider-runnable-track {
    height: 6px; border-radius: 3px;
    background: linear-gradient(to right, #fff var(--fill, 0%), rgba(255,255,255,.2) var(--fill, 0%));
  }
  input[type="range"].seek-slider::-webkit-slider-thumb {
    -webkit-appearance: none; width: 16px; height: 16px; margin-top: -5px;
    border-radius: 50%; background: #fff; opacity: 1;
    box-shadow: 0 1px 4px rgba(0,0,0,.55);
    transition: transform .12s ease;
  }
  input[type="range"].seek-slider:hover::-webkit-slider-thumb,
  input[type="range"].seek-slider:active::-webkit-slider-thumb { transform: scale(1.3); }
  input[type="range"].seek-slider::-moz-range-track { height: 6px; border-radius: 3px; background: rgba(255,255,255,.2); }
  input[type="range"].seek-slider::-moz-range-progress { height: 6px; border-radius: 3px; background: #fff; }
  input[type="range"].seek-slider::-moz-range-thumb {
    width: 16px; height: 16px; border: none; border-radius: 50%; background: #fff;
  }

  .controls { display: flex; align-items: center; justify-content: center; gap: 26px; margin-top: clamp(10px, 1.6vh, 18px); }
  .ctrl {
    display: flex; align-items: center; justify-content: center;
    width: 56px; height: 56px; border: none; border-radius: 50%;
    background: transparent; color: #fff;
    cursor: pointer; transition: background .15s, color .15s;
  }
  .ctrl:hover { background: rgba(255,255,255,.12); color: #fff; }
  .ctrl:disabled { cursor: default; }
  .ctrl:disabled:hover { background: transparent; }
  .ctrl.active { color: #fff; }
  .ctrl.small { width: 28px; height: 28px; color: rgba(255,255,255,.8); }
  .ctrl.small.active { color: #fff; background: rgba(255,255,255,.16); }
  .ctrl.small.active:hover { background: rgba(255,255,255,.24); }
  .play-btn {
    position: relative;
    display: flex; align-items: center; justify-content: center;
    width: 84px; height: 84px; border: none; border-radius: 50%;
    background: transparent; color: #fff; cursor: pointer;
    transition: transform .12s ease, background .15s;
  }
  .play-btn:hover { transform: scale(1.06); background: rgba(255,255,255,.1); }
  .play-btn:active { transform: scale(.97); }

  /* Плеер «дышит», пока играет музыка: тонкое расходящееся кольцо */
  body.is-playing .play-btn::after {
    content: "";
    position: absolute; inset: -2px; border-radius: 50%;
    border: 1.5px solid rgba(255,255,255,.26);
    pointer-events: none;
    animation: play-ring 3.2s cubic-bezier(.22, 1, .36, 1) infinite;
  }
  @keyframes play-ring {
    0% { transform: scale(.9); opacity: 0; }
    30% { opacity: .55; }
    100% { transform: scale(1.32); opacity: 0; }
  }

  #playerView:not(.hidden) .content { animation: view-in .55s cubic-bezier(.22, 1, .36, 1) both; }
  @keyframes view-in {
    from { opacity: 0; transform: translateY(12px) scale(.994); }
    to { opacity: 1; transform: none; }
  }

  .volume { display: flex; align-items: center; gap: 18px; margin-top: clamp(8px, 1.4vh, 16px); }
  .volume .ctrl.small { color: #fff; }
  .volume .ctrl.small { flex: 0 0 52px; width: 52px; height: 52px; }
  .vol-wrap { position: relative; display: flex; align-items: center; flex: 1 1 auto; min-width: 0; }
  .volume .slider { width: 100%; }

  /* у повтора две иконки: петля и петля с единицей */
  #repeatBtn svg .one { opacity: 0; transition: opacity .2s ease; }
  #repeatBtn.active svg .one { opacity: 1; }
  #miniRepeat svg .one { opacity: 0; transition: opacity .2s ease; }
  #miniRepeat.active svg .one { opacity: 1; }

  .vol-tip {
    position: absolute; top: -35px; left: 50%;
    transform: translate(-50%, 4px);
    padding: 4px 10px; border-radius: 8px;
    background: rgba(18,17,16,.92); border: 1px solid rgba(255,255,255,.12);
    font-size: 16px; color: #fff; font-variant-numeric: tabular-nums;
    opacity: 0; pointer-events: none; white-space: nowrap;
    transition: opacity .15s ease, transform .15s ease;
  }
  .volume.adjusting .vol-tip { opacity: 1; transform: translate(-50%, 0); }

  /* анимация иконки звука: волны схлопываются, перечёркивание прорисовывается */
  #muteBtn svg .wave {
    transform-origin: 12px 12px;
    transition: opacity .18s ease, transform .26s cubic-bezier(.4, 0, .2, 1);
  }
  #muteBtn.muted svg .wave { opacity: 0; transform: scale(.45); }
  #muteBtn.low svg .wave2 { opacity: 0; transform: scale(.85); }
  #muteBtn svg .slash {
    stroke-dasharray: 22; stroke-dashoffset: 22;
    transition: stroke-dashoffset .26s cubic-bezier(.4, 0, .2, 1) .06s;
  }
  #muteBtn.muted svg .slash { stroke-dashoffset: 0; }

  /* мягкое появление новой иконки play/pause */
  @keyframes icon-pop {
    from { transform: scale(.82); opacity: .55; }
    to { transform: scale(1); opacity: 1; }
  }
  #playBtn svg { animation: icon-pop .18s cubic-bezier(.4, 0, .2, 1); }

  input[type="range"].volume-slider { height: 32px; }
  input[type="range"].volume-slider::-webkit-slider-runnable-track {
    height: 7px; border-radius: 4px;
    background: linear-gradient(to right, #fff var(--fill, 90%), rgba(255,255,255,.16) var(--fill, 90%));
  }
  input[type="range"].volume-slider::-webkit-slider-thumb {
    -webkit-appearance: none; width: 18px; height: 18px; margin-top: -5.5px;
    border-radius: 50%; background: #fff; opacity: 1;
    box-shadow: 0 1px 4px rgba(0,0,0,.55);
    transition: transform .12s ease;
  }
  input[type="range"].volume-slider:hover::-webkit-slider-thumb,
  input[type="range"].volume-slider:active::-webkit-slider-thumb { transform: scale(1.3); }
  input[type="range"].volume-slider::-moz-range-track { height: 7px; border-radius: 4px; background: rgba(255,255,255,.16); }
  input[type="range"].volume-slider::-moz-range-progress { height: 7px; border-radius: 4px; background: #fff; }
  input[type="range"].volume-slider::-moz-range-thumb {
    width: 18px; height: 18px; border: none; border-radius: 50%; background: #fff;
  }

  /* ------------------------------- lyrics ------------------------------- */
  .lyrics-panel { position: relative; height: 100%; min-height: 0; }

  .lyrics-scroll {
    position: relative; height: 100%; overflow-y: auto;
    padding: 27vh 0 33vh;
    scrollbar-width: none;
    mask-image: linear-gradient(180deg, transparent 0%, #000 10%, #000 88%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 10%, #000 88%, transparent 100%);
  }
  .lyrics-scroll::-webkit-scrollbar { display: none; }

  .lyric-line {
    padding: 12px 0;
    font-size: clamp(26px, 2.9vw, 42px);
    font-weight: 700; line-height: 1.32; letter-spacing: -.016em;
    color: rgba(255,255,255,.96);
    opacity: var(--fade, 1);
    transform-origin: left center;
    transition: color .45s ease, opacity .55s ease, transform .65s cubic-bezier(.22, 1, .36, 1);
    animation: line-rise .72s cubic-bezier(.22, 1, .36, 1) backwards;
    animation-delay: min(calc(var(--i, 0) * 34ms), 620ms);
    will-change: opacity, transform;
    cursor: pointer;
  }
  @keyframes line-rise {
    from { opacity: 0; transform: translateY(22px); filter: blur(7px); }
    to { opacity: var(--fade, 1); transform: none; filter: blur(0); }
  }

  .lyric-line .txt {
    position: relative;
    display: inline-block;
    max-width: 100%;
    transition: text-shadow .5s ease;
  }
  .lyric-line:hover { color: #fff; }
  .lyric-line.active {
    color: #fff;
    transform: scale(1.03);
  }
  .lyric-line.active .txt {
    animation: line-focus .8s cubic-bezier(.22, 1, .36, 1);
    text-shadow: 0 0 22px rgba(255,255,255,.34), 0 0 52px rgba(255,255,255,.12);
  }
  @keyframes line-focus {
    0% { transform: translateY(7px); opacity: .35; text-shadow: 0 0 40px rgba(255,255,255,.6); }
    100% { transform: none; opacity: 1; text-shadow: 0 0 22px rgba(255,255,255,.34), 0 0 52px rgba(255,255,255,.12); }
  }

  .lyrics-status {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    padding: 0 24px; font-size: 14px; color: rgba(255,255,255,.42);
    text-align: center; pointer-events: none;
  }

  /* Инструментальная вставка: нота, которая заливается снизу вверх */
  .lyric-line.note {
    padding: 22px 0;
    font-size: clamp(46px, 4.4vw, 62px);
    letter-spacing: 0;
    line-height: 1;
    color: rgba(255,255,255,.30);
  }
  .lyric-line.note.active { color: rgba(255,255,255,.34); transform: scale(1.05); }
  .lyric-line.note .note-art {
    position: relative;
    display: inline-block;
    width: .78em; height: 1em;
    vertical-align: middle;
    transition: transform .6s cubic-bezier(.22, 1, .36, 1);
  }
  .lyric-line.note .note-art::before {
    content: "";
    position: absolute; left: 50%; top: 52%;
    width: 2.1em; height: 2.1em;
    transform: translate(-50%, -50%) scale(.86);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,240,219,.2) 0%, rgba(255,240,219,.08) 42%, rgba(255,240,219,0) 68%);
    opacity: 0;
    pointer-events: none;
    transition: opacity .7s ease, transform 1.1s cubic-bezier(.22, 1, .36, 1);
  }
  .lyric-line.note.active .note-art::before {
    opacity: .75;
    transform: translate(-50%, -50%) scale(1);
  }
  .lyric-line.note.active .note-art {
    filter: drop-shadow(0 6px 14px rgba(0,0,0,.4));
  }
  body.is-playing .lyric-line.note.active .note-art {
    animation: note-float 3.6s ease-in-out infinite;
  }
  @keyframes note-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-5px) rotate(-1.6deg); }
  }
  .note-svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .note-art .base { color: inherit; }
  .note-fill {
    position: absolute; inset: 0;
    color: #fff;
    opacity: 0;
    clip-path: inset(calc((1 - var(--p, 0)) * 100%) 0 0 0);
    -webkit-clip-path: inset(calc((1 - var(--p, 0)) * 100%) 0 0 0);
    transition: opacity .35s ease;
  }
  .lyric-line.note.active .note-fill { opacity: 1; transition: none; }

  .toast {
    position: fixed; bottom: 106px; left: 50%; z-index: 60;
    transform: translateX(-50%);
    padding: 10px 16px;
    border: 1px solid rgba(255,255,255,.1); border-radius: 10px;
    background: rgba(28,27,25,.94);
    box-shadow: 0 10px 30px rgba(0,0,0,.42);
    color: #fff; font-size: 13px;
    backdrop-filter: blur(10px);
    animation: toast-in .2s ease;
  }
  @keyframes toast-in { from { opacity: 0; transform: translate(-50%, 8px); } to { opacity: 1; transform: translate(-50%, 0); } }

  body.dragover::after {
    content: "Отпусти — добавлю в библиотеку";
    position: fixed; inset: 14px; z-index: 70;
    display: flex; align-items: center; justify-content: center;
    border: 2px dashed rgba(255,255,255,.35); border-radius: 16px;
    background: rgba(0,0,0,.55); color: #fff; font-size: 17px; font-weight: 600;
    backdrop-filter: blur(6px);
  }

  /* --------------------------------- views -------------------------------- */
  .views { position: relative; flex: 1 1 auto; min-height: 0; }
  .view { position: absolute; inset: 0; }

  /* ------------------------------ home screen ------------------------------ */
  #homeView { display: flex; }

  .rail {
    flex: 0 0 88px; display: flex; flex-direction: column; align-items: center;
    gap: 4px; padding: 8px 0 16px;
  }
  .rail .brand-mark { width: 36px; height: 36px; margin: 4px 0 16px; color: #fff; }
  .rail-btn {
    width: 70px; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 5px; padding: 8px 2px 7px;
    border: none; border-radius: 12px; background: transparent;
    color: rgba(255,255,255,.6); cursor: pointer;
    transition: background .15s, color .15s;
  }
  .rail-label {
    font-size: 10px; line-height: 1; font-weight: 600; letter-spacing: .01em;
    color: currentColor; opacity: .85; white-space: nowrap;
  }
  .rail-btn.active .rail-label { opacity: 1; }
  .rail-btn:hover { color: #fff; background: rgba(255,255,255,.09); }
  .rail-btn.active { color: #fff; background: rgba(255,255,255,.14); }
  .rail-gap { flex: 1 1 auto; }

  .home-scroll {
    flex: 1 1 auto; min-width: 0; overflow-y: auto;
    padding: 12px clamp(16px, 3vw, 40px) 30px clamp(8px, 1.2vw, 18px);
    scrollbar-width: none;
  }
  .home-scroll::-webkit-scrollbar { display: none; }

  /* -------------------- панель «Сейчас играет» справа --------------------- */
  .np-side {
    position: relative;
    flex: 0 0 clamp(320px, 23vw, 356px);
    width: clamp(320px, 23vw, 356px);
    display: flex; flex-direction: column;
    min-height: 0; overflow: hidden;
    padding: 10px clamp(18px, 1.6vw, 24px) 22px;
    border-left: 1px solid rgba(255,255,255,.06);
  }
  .np-side-glow {
    position: absolute; left: -18%; right: -18%; top: -6%; height: 68%;
    background-position: center; background-size: cover;
    filter: blur(64px) saturate(1.35) brightness(.9);
    opacity: .3; pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, rgba(0,0,0,.4) 58%, transparent 94%);
    mask-image: linear-gradient(180deg, #000 0%, rgba(0,0,0,.4) 58%, transparent 94%);
    transition: opacity .45s ease;
  }
  .np-side-glow.empty { opacity: 0; }
  .np-side-inner {
    position: relative; z-index: 1;
    display: flex; flex-direction: column;
    height: 100%; min-height: 0;
  }
  .np-side-head { display: flex; align-items: center; gap: 11px; padding-top: 2px; }
  .np-side-head .np-badge { width: 36px; height: 36px; }
  .np-side-head .np-label { font-size: 9.5px; letter-spacing: .18em; }
  .np-side-head .np-title { font-size: 14px; }

  .np-side-cover {
    position: relative;
    width: 100%; aspect-ratio: 1 / 1;
    margin-top: clamp(16px, 2.4vh, 26px);
    border-radius: 14px; overflow: hidden;
    background: linear-gradient(140deg, #3a3733, #1b1a18);
    box-shadow: 0 26px 58px rgba(0,0,0,.5), 0 2px 8px rgba(0,0,0,.34);
    flex: 0 0 auto;
    cursor: pointer;
    transition: transform .28s cubic-bezier(.22, 1, .36, 1), box-shadow .28s ease;
  }
  .np-side-cover:hover { transform: translateY(-3px) scale(1.012); box-shadow: 0 32px 68px rgba(0,0,0,.56), 0 2px 10px rgba(0,0,0,.4); }
  .np-side-cover:active { transform: scale(.992); }
  .np-side-cover:focus-visible { outline: 2px solid rgba(255,255,255,.75); outline-offset: 3px; }
  .np-side-cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .np-side-cover::after {
    content: ""; position: absolute; inset: 0;
    border-radius: inherit; pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.08);
  }

  .np-side-track {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 12px; margin-top: clamp(14px, 2vh, 20px);
  }
  .np-side-meta { min-width: 0; }
  .np-side-name {
    font-size: 22px; font-weight: 750; line-height: 1.2; letter-spacing: -.02em;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .np-side-name.swap { animation: np-swap .5s cubic-bezier(.22, 1, .36, 1); }
  .np-side-artist {
    display: flex; align-items: center; gap: 8px;
    margin-top: 6px; font-size: 13.5px; color: var(--muted); min-width: 0;
  }
  .np-side-artist .avatar {
    flex: 0 0 auto; width: 24px; height: 24px; border-radius: 50%;
    object-fit: cover; background: rgba(255,255,255,.16);
  }
  .np-side-artist span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .np-like {
    flex: 0 0 auto; width: 40px; height: 40px;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid rgba(255,255,255,.14); border-radius: 11px;
    background: rgba(255,255,255,.05); color: #fff;
    cursor: pointer; transition: background .15s, color .15s, transform .12s;
  }
  .np-like:hover { background: rgba(255,255,255,.14); }
  .np-like:active { transform: scale(.94); }
  .np-like.active { background: #fff; color: #121212; border-color: #fff; }
  .np-like svg .check { opacity: 0; transition: opacity .16s ease; }
  .np-like svg .plus { opacity: 1; transition: opacity .16s ease; }
  .np-like.active svg .check { opacity: 1; }
  .np-like.active svg .plus { opacity: 0; }

  .np-side-progress { margin-top: clamp(10px, 1.8vh, 18px); }
  .np-side-progress .seek-slider { height: 24px; }
  .np-side-progress .time-row { margin-top: 1px; }
  .np-side-progress .time { font-size: 12.5px; color: rgba(255,255,255,.55); }

  .np-side-controls {
    display: flex; align-items: center; justify-content: space-between;
    gap: 4px; margin-top: 8px;
  }
  .np-ctrl {
    display: flex; align-items: center; justify-content: center;
    width: 42px; height: 42px; border: none; border-radius: 50%;
    background: transparent; color: rgba(255,255,255,.78);
    cursor: pointer; transition: background .15s, color .15s;
  }
  .np-ctrl:hover { background: rgba(255,255,255,.1); color: #fff; }
  .np-ctrl.active { color: #fff; }
  .np-ctrl svg { width: 21px; height: 21px; }
  .np-play {
    display: flex; align-items: center; justify-content: center;
    width: 54px; height: 54px; border: none; border-radius: 50%;
    background: #fff; color: #121212; cursor: pointer;
    box-shadow: 0 8px 24px rgba(0,0,0,.4);
    transition: transform .12s ease, background .15s;
  }
  .np-play:hover { transform: scale(1.05); }
  .np-play:active { transform: scale(.96); }
  .np-play svg { width: 25px; height: 25px; }
  #sideRepeat svg .one { opacity: 0; transition: opacity .2s ease; }
  #sideRepeat.active svg .one { opacity: 1; }

  .np-side-volume {
    display: flex; align-items: center; gap: 10px;
    margin-top: auto; padding-top: 16px;
  }
  .np-side-volume .ctrl.small { flex: 0 0 30px; width: 30px; height: 30px; color: rgba(255,255,255,.8); }
  .np-side-volume .ctrl.small:hover { color: #fff; background: transparent; }
  .np-side-volume .slider { flex: 1 1 auto; width: 100%; }
  #sideMute svg { width: 22px; height: 22px; }
  #sideMute svg .wave {
    transform-origin: 12px 12px;
    transition: opacity .18s ease, transform .26s cubic-bezier(.4, 0, .2, 1);
  }
  #sideMute.muted svg .wave { opacity: 0; transform: scale(.45); }
  #sideMute.low svg .wave2 { opacity: 0; transform: scale(.85); }
  #sideMute svg .slash {
    stroke-dasharray: 22; stroke-dashoffset: 22;
    transition: stroke-dashoffset .26s cubic-bezier(.4, 0, .2, 1) .06s;
  }
  #sideMute.muted svg .slash { stroke-dashoffset: 0; }

  .home-title {
    display: flex; align-items: center; gap: 14px;
    margin: 0 0 18px; font-size: clamp(24px, 2.4vw, 34px); font-weight: 800;
    letter-spacing: -.03em;
  }
  .home-mark {
    width: clamp(26px, 2.3vw, 32px); height: clamp(26px, 2.3vw, 32px);
    border-radius: 9px; object-fit: cover; flex: 0 0 auto;
    background: linear-gradient(140deg,#4c9be8,#2b6fd0);
  }

  .mixes {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 1.8vw, 26px); max-width: 1080px;
  }
  .mix { cursor: pointer; }
  .mix-art {
    position: relative; aspect-ratio: 1/1; border-radius: 12px; overflow: hidden;
    background: #23211f;
    box-shadow: 0 16px 34px rgba(0,0,0,.42);
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .mix:hover .mix-art { transform: translateY(-3px); box-shadow: 0 22px 42px rgba(0,0,0,.52); }
  .mix-art img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .mix-art.g1 { background: linear-gradient(150deg,#dad2c4,#b8a692 58%,#97846f); }
  .mix-art.g2 { background: linear-gradient(150deg,#2c3f55,#111c26 62%,#090f15); }
  .mix-art.g4 { background: linear-gradient(150deg,#422853,#1c1025 66%,#0c0712); }
  .mix-tag { position: absolute; left: 12px; top: 12px; color: #fff; opacity: .9; }
  .mix-cover {
    position: absolute; left: 14px; bottom: 12px;
    font-size: clamp(19px, 2vw, 32px); font-weight: 800; line-height: .84;
    letter-spacing: -.04em; color: #fff;
    text-shadow: 0 2px 12px rgba(0,0,0,.32);
