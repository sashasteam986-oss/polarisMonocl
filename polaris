    var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="320" height="320" viewBox="0 0 320 320">' +
      '<defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1">' +
      '<stop offset="0" stop-color="hsl(' + hue + ',46%,46%)"/>' +
      '<stop offset="1" stop-color="hsl(' + hue2 + ',52%,14%)"/>' +
      '</linearGradient></defs>' +
      '<rect width="320" height="320" fill="url(#g)"/>' +
      '<circle cx="' + cx + '" cy="' + cy + '" r="150" fill="rgba(255,255,255,.08)"/>' +
      '<circle cx="' + (320 - cx) + '" cy="' + (320 - cy) + '" r="88" fill="rgba(0,0,0,.12)"/>' +
      '</svg>';
    return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
  }

  function coverFor(track) {
    if (!track) return gradientCover('polaris');
    if (track.id === 'builtin') {
      return ($('coverData').textContent || '').trim() || gradientCover(BUILTIN.title);
    }
    return track.art || track.cover || gradientCover(track.title);
  }

  function libraryTrack(id) {
    for (var i = 0; i < state.tracks.length; i++) {
      if (state.tracks[i].id === id) return state.tracks[i];
    }
    return null;
  }

  function currentTrack() {
    if (state.current && state.current.id === state.currentId) return state.current;
    var record = state.currentId === 'builtin' ? null : libraryTrack(state.currentId);
    if (record) return record;
    return { id: 'builtin', title: BUILTIN.title, artist: BUILTIN.artist, duration: BUILTIN.duration };
  }

  function renderTracks() {
    var grid = $('trackGrid');
    if (!grid) return;

    var list = [];
    if (direct.view.length) list = list.concat(direct.view);
    list = list.concat([{ id: 'builtin', title: BUILTIN.title, artist: BUILTIN.artist, duration: BUILTIN.duration, builtin: true }]);
    if (sc.sounds.length) list = list.concat(sc.sounds);
    list = list.concat(state.tracks);

    grid.innerHTML = list.map(function (track) {
      var playing = track.id === state.currentId ? ' playing' : '';
      var remove = (track.builtin || track.url || track.direct) ? '' :
        '<button class="track-more" data-del="' + esc(track.id) + '" title="Удалить из библиотеки">✕</button>';
      var duration = track.duration ? formatTime(track.duration) : '—';
      var scAttr = (track.url && !track.direct) ? ' data-sc="' + track.scIndex + '"' : '';
      var directAttr = track.direct ? ' data-direct="1"' : '';
      return '<div class="track-row' + playing + '" data-id="' + esc(track.id) + '"' + scAttr + directAttr + ' role="button" tabindex="0">' +
        '<img class="track-thumb" src="' + coverFor(track) + '" alt="">' +
        '<div class="track-meta">' +
        '<div class="track-name">' + esc(track.title) + '</div>' +
        '<div class="track-sub">' + esc(track.artist || 'Без исполнителя') + '</div>' +
        '</div>' +
        '<span class="track-dur">' + duration + '</span>' +
        remove +
        '</div>';
    }).join('');

    var addBtn = $('addTracksBtn');
    if (addBtn) addBtn.classList.toggle('hidden', sc.sounds.length > 0 || direct.view.length > 0);
    $('libHint').classList.toggle('hidden', state.tracks.length > 0 || sc.sounds.length > 0 || direct.view.length > 0);
  }

  /* --------------------------- direct soundcloud -------------------------- */

  function directRecord(track, artistHint) {
    if (!track || !track.id) return null;
    return {
      id: 'd' + track.id,
      sid: track.id,
      title: track.title || 'Без названия',
      artist: (track.user && track.user.username) || artistHint || '',
      feedArtist: artistHint || '',
      duration: Math.round((track.duration || 0) / 1000),
      art: track.artwork_url ? String(track.artwork_url).replace(/-large\./, '-t500x500.') : '',
      permalink: track.permalink_url || '',
      track_authorization: track.track_authorization || '',
      direct: true,
      streamable: track.streamable !== false && track.policy !== 'BLOCK',
      playable: hasPlainStream(track),
      transcodings: (track.media && track.media.transcodings) || []
    };
  }

  // DRM-потоки (SAMPLE-AES) браузер расшифровать не может — их не показываем
  function hasPlainStream(track) {
    var list = (track.media && track.media.transcodings) || [];
    if (!list.length) return true;
    for (var i = 0; i < list.length; i++) {
      var format = list[i] && list[i].format;
      if (format && (format.protocol === 'progressive' || format.protocol === 'hls')) return true;
    }
    return false;
  }

  function fetchDirect(url) {
    return fetch(proxyUrl(url)).then(function (response) {
      if (!response.ok) throw new Error('HTTP ' + response.status);
      return response.json();
    });
  }

  var FEED_CACHE = 'polaris.feed';

  function readFeedCache() {
    try {
      var saved = JSON.parse(localStorage.getItem(FEED_CACHE) || 'null');
      if (!saved || !saved.feed || !saved.feed.length) return null;
      return saved.feed;
    } catch (e) {
      return null;
    }
  }

  function writeFeedCache(feed) {
    try {
      localStorage.setItem(FEED_CACHE, JSON.stringify({ at: Date.now(), feed: feed }));
    } catch (e) {}
  }

  // Показываем сохранённую ленту сразу, пока в фоне идёт обновление
  function restoreFeedCache() {
    var feed = readFeedCache();
    if (!feed) return false;
    direct.feed = feed;
    direct.view = feed;
    renderTracks();
    renderDirectArtists();
    return true;
  }

  function loadDirectFeed() {
    if (direct.loading) return Promise.resolve();
    direct.loading = true;
    scStatus(direct.feed.length
      ? 'SoundCloud: ' + direct.feed.length + ' треков — обновляю…'
      : 'Загружаю треки SoundCloud…');

    var collected = [];

    var requests = SC_ARTISTS.map(function (artist) {
      var url = 'https://api-v2.soundcloud.com/search/tracks?q=' +
        encodeURIComponent(artist) + '&limit=6&client_id=' + SC_CLIENT_ID;
      return fetchDirect(url).then(function (data) {
        (data.collection || []).forEach(function (track) {
          var record = directRecord(track, artist);
          if (record && record.streamable && record.playable) collected.push(record);
        });
      }).catch(function () {});
    });

    return Promise.all(requests).then(function () {
      var seen = {};
      var feed = collected.filter(function (track) {
        if (seen[track.id]) return false;
        seen[track.id] = 1;
        return true;
      });

      direct.loading = false;

      if (!feed.length) {
        scStatus(direct.feed.length
          ? 'SoundCloud: ' + direct.feed.length + ' треков'
          : 'SoundCloud не отдал треки — вставь ссылку на плейлист');
        return;
      }

      var showingFeed = direct.view === direct.feed;
      direct.feed = feed;
      if (showingFeed || !direct.view.length) direct.view = feed;
      writeFeedCache(feed);
      renderTracks();
      renderDirectArtists();
      scStatus('SoundCloud: ' + feed.length + ' треков загружено');

      // Заранее готовим первые треки, чтобы клик срабатывал почти сразу.
      // Сначала два трека целиком (ссылка + сегменты), дальше — только ссылки.
      setTimeout(function () {
        if (direct.view[0]) prefetchDirect(direct.view[0]);
      }, 900);
      setTimeout(function () {
        if (direct.view[1]) prefetchDirect(direct.view[1]);
      }, 2000);
      for (var i = 2; i < Math.min(8, direct.view.length); i++) {
        (function (index) {
          setTimeout(function () {
            if (index < direct.view.length) resolveOnly(direct.view[index]);
          }, 3200 + (index - 2) * 500);
        })(i);
      }
    }).catch(function () {
      direct.loading = false;
      scStatus(direct.feed.length
        ? 'SoundCloud: ' + direct.feed.length + ' треков (без обновления)'
        : 'Не удалось загрузить треки SoundCloud');
    });
  }

  function renderDirectArtists() {
    var cards = document.querySelectorAll('.mix');
    Array.prototype.forEach.call(cards, function (card, index) {
      var artist = MIX_ARTISTS[index];
      if (!artist) return;
      var list = direct.feed.filter(function (track) {
        var hay = (track.feedArtist + ' ' + track.artist + ' ' + track.title).toLowerCase();
        return hay.indexOf(artist.toLowerCase()) >= 0;
      });
      var first = list[0];
      if (!first) return;

      var art = card.querySelector('.mix-art');
      if (art && first.art) {
        art.style.backgroundImage = 'linear-gradient(rgba(0,0,0,.3), rgba(0,0,0,.55)), url("' + first.art + '")';
      }
      var sub = card.querySelector('.mix-sub');
      if (sub) sub.textContent = artist + ' · ' + list.length + ' трек(ов)';
      card.setAttribute('data-artist', artist);
    });
  }

  function searchDirect(query) {
    var text = String(query || '').trim();
    if (!text) { toast('Введи название или артиста'); return; }

    scStatus('Ищу: ' + text + '…');
    var url = 'https://api-v2.soundcloud.com/search/tracks?q=' +
      encodeURIComponent(text) + '&limit=20&client_id=' + SC_CLIENT_ID;

    fetchDirect(url).then(function (data) {
      direct.view = (data.collection || [])
        .map(function (track) { return directRecord(track); })
        .filter(function (track) { return track && track.streamable && track.playable; });
      renderTracks();
      scStatus('Найдено: ' + direct.view.length + ' — нажми трек');
      toast('Найдено треков: ' + direct.view.length);
      scrollHomeTo(document.querySelector('.section-head'));
    }).catch(function () {
      toast('Поиск не сработал');
      scStatus('Поиск не сработал');
    });
  }

  function stopDirect() {
    if (direct.hls) {
      try { direct.hls.destroy(); } catch (e) {}
      direct.hls = null;
    }
    if (state.source === 'direct') audio.pause();
  }

  // CDN SoundCloud отдаёт плейлисты и сегменты напрямую с CORS — прокси не нужен.
  // Если прямой запрос всё же не прошёл, один раз повторяем через прокси.
  function FastLoader(config) {
    var base = new Hls.DefaultConfig.loader(config);

    this.load = function (context, cfg, callbacks) {
      var target = (context && context.url) || '';
      var usedProxy = target.indexOf(CORS_PROXY) === 0;

      function attempt(url) {
        var ctx = {};
        for (var key in context) {
          if (Object.prototype.hasOwnProperty.call(context, key)) ctx[key] = context[key];
        }
        ctx.url = url;

        base.load(ctx, cfg, {
          onSuccess: function (response, stats, c, net) {
            if (callbacks.onSuccess) callbacks.onSuccess(response, stats, context, net);
          },
          onError: function (error, stats, c, net) {
            if (!usedProxy) {
              usedProxy = true;
              attempt(proxyUrl(target));
              return;
            }
            if (callbacks.onError) callbacks.onError(error, stats, context, net);
          },
          onTimeout: function (stats, c, net) {
            if (!usedProxy) {
              usedProxy = true;
              attempt(proxyUrl(target));
              return;
            }
            if (callbacks.onTimeout) callbacks.onTimeout(stats, context, net);
          },
          onProgress: function (stats, c, data, net) {
            if (callbacks.onProgress) callbacks.onProgress(stats, context, data, net);
          }
        });
      }

      attempt(target);
    };

    this.abort = function () { base.abort(); };
    this.destroy = function () { base.destroy(); };
    Object.defineProperty(this, 'stats', { get: function () { return base.stats; } });
    Object.defineProperty(this, 'context', {
      get: function () { return base.context; },
      set: function (value) { base.context = value; }
    });
  }

  function loadHls(url, token, record, retried) {
    if (!window.Hls) {
      if (audio.canPlayType('application/vnd.apple.mpegurl')) {
        audio.src = url;
        audio.play().catch(function () {});
        return;
      }
      status('Браузер не поддерживает HLS');
      return;
    }

    if (direct.hls) { direct.hls.destroy(); direct.hls = null; }

    var hls = new Hls({
      loader: FastLoader,
      enableWorker: true,
      lowLatencyMode: false,
      startFragPrefetch: true,
      testBandwidth: false,
      abrEwmaDefaultEstimate: 1500000,
      maxBufferLength: 20,
      manifestLoadingTimeOut: 10000,
      fragLoadingTimeOut: 10000
    });
    direct.hls = hls;
    hls.attachMedia(audio);

    hls.on(Hls.Events.MEDIA_ATTACHED, function () {
      hls.loadSource(url);
      // Не ждём разбора манифеста: play() раскрутит воспроизведение,
      // как только hls.js добавит первый сегмент
      if (token === state.token) audio.play().catch(function () {});
    });

    hls.on(Hls.Events.MANIFEST_PARSED, function () {
      if (token !== state.token) return;
      audio.play().catch(function () {});
    });

    hls.on(Hls.Events.ERROR, function (event, data) {
      if (!data || !data.fatal) return;

      // Ссылка из кэша могла устареть — получаем свежую и пробуем ещё раз
      if (data.type === Hls.ErrorTypes.NETWORK_ERROR && record && !retried) {
        hls.destroy();
        direct.hls = null;
        forgetStream(record.id);
        resolveDirectStream(record, true).then(function (stream) {
          if (token !== state.token) return;
          if (stream.protocol === 'progressive') loadProgressive(stream.url, record);
          else loadHls(stream.url, token, record, true);
        }).catch(function () {
          if (token !== state.token) return;
          status('Не удалось загрузить поток');
          toast('Поток не загрузился — попробуй другой трек');
        });
        return;
      }

      status('Не удалось загрузить поток');
      toast('Поток не загрузился — попробуй другой трек');
      hls.destroy();
      direct.hls = null;
    });
  }

  function loadProgressive(url, record) {
    audio.src = url;
    audio.play().catch(function () {});

    if (!record) return;

    function onError() {
      audio.removeEventListener('error', onError);
      if (state.currentId !== record.id) return;
      forgetStream(record.id);
      resolveDirectStream(record, true).then(function (stream) {
        if (state.currentId !== record.id) return;
        if (stream.protocol === 'progressive') loadProgressive(stream.url, record);
        else loadHls(stream.url, state.token, record, true);
      }).catch(function () {});
    }
    function onPlaying() {
      audio.removeEventListener('error', onError);
      audio.removeEventListener('playing', onPlaying);
    }

    audio.addEventListener('error', onError);
    audio.addEventListener('playing', onPlaying);
  }

  function pickTranscoding(list) {
    var progressive = null;
    var hls = null;
    for (var i = 0; i < list.length; i++) {
      var item = list[i];
      if (!item || !item.format) continue;
      if (item.format.protocol === 'progressive' && !progressive) progressive = item;
      if (item.format.protocol === 'hls' && !hls) hls = item;
    }
    return progressive || hls;
  }

  // Транскодинги уже пришли вместе с результатами поиска — лишний запрос не нужен
  function transcodingsFor(record) {
    if (record.transcodings && record.transcodings.length) {
      return Promise.resolve({ list: record.transcodings, auth: record.track_authorization || '' });
    }
    var url = 'https://api-v2.soundcloud.com/tracks/' + record.sid + '?client_id=' + SC_CLIENT_ID;
    return fetchDirect(url).then(function (track) {
      return {
        list: (track.media && track.media.transcodings) || [],
        auth: track.track_authorization || record.track_authorization || ''
      };
    });
  }

  function forgetStream(id) {
    delete direct.streams[id];
  }

  function resolveDirectStream(record, force) {
    // Подписанные ссылки CDN живут недолго, поэтому кэш только в памяти и на 8 минут
    var cached = direct.streams[record.id];
    if (!force && cached && Date.now() - cached.at < 8 * 60 * 1000) {
      return Promise.resolve(cached);
    }
    return transcodingsFor(record).then(function (info) {
      var pick = pickTranscoding(info.list);
      if (!pick) throw new Error('no stream');
      var url = pick.url +
        (pick.url.indexOf('?') >= 0 ? '&' : '?') +
        'client_id=' + SC_CLIENT_ID +
        '&track_authorization=' + encodeURIComponent(info.auth);
      return fetchDirect(url).then(function (data) {
        if (!data || !data.url) throw new Error('no url');
        var stream = { url: data.url, protocol: pick.format.protocol, at: Date.now() };
        direct.streams[record.id] = stream;
        return stream;
      });
    });
  }

  // Прогреваем плейлист и первые сегменты, чтобы старт брался из кэша браузера
  function warmHls(stream) {
    if (!stream || stream.protocol !== 'hls' || stream.warmed) return;
    stream.warmed = true;

    fetch(stream.url).then(function (response) {
      return response.text();
    }).then(function (text) {
      var map = (text.match(/#EXT-X-MAP:URI="([^"]+)"/) || [])[1];
      var lines = text.split('\n');
      var segs = [];
      for (var i = 0; i < lines.length && segs.length < 2; i++) {
        var line = lines[i].trim();
        if (line && line.charAt(0) !== '#') segs.push(line);
      }
      if (map) fetch(map).catch(function () {});
      segs.forEach(function (seg) { fetch(seg).catch(function () {}); });
    }).catch(function () {});
  }

  function prefetchDirect(record) {
    if (!record || !record.direct || record.playable === false) return;
    resolveDirectStream(record).then(warmHls).catch(function () {});
  }

  // Только ссылка на поток: ответ крошечный, зато клик не ждёт прокси
  function resolveOnly(record) {
    if (!record || !record.direct || record.playable === false) return;
    resolveDirectStream(record).catch(function () {});
  }

  function nextDirectRecord(id) {
    var index = -1;
    for (var i = 0; i < direct.view.length; i++) {
      if (direct.view[i].id === id) { index = i; break; }
    }
    for (var j = index + 1; j < direct.view.length; j++) {
      if (direct.view[j].direct && direct.view[j].playable !== false) return direct.view[j];
    }
    return null;
  }

  function loadDirectLyrics(record, token) {
    var cached = freshLyrics(record);
    if (cached) {
      setLines(parseLrc(cached));
      updateActive(true);
      return;
    }
    if (record.lrcMiss) {
      status('Текст не найден — играет как есть');
      return;
    }
    status('Ищу текст…');
    searchLyrics(record.artist, record.title, record.duration).then(function (found) {
      if (token !== state.token || state.source !== 'direct') return;
      if (found) {
        record.lrc = found;
        record.lrcv = LRC_V;
        setLines(parseLrc(found));
        status('');
        updateActive(true);
      } else {
        record.lrcMiss = true;
        status('Текст не найден — играет как есть');
      }
    });
  }

  function playDirect(record) {
    if (!record) return;

    stopDirect();
    state.token += 1;
    var token = state.token;
    state.source = 'direct';
    state.currentId = record.id;
    state.current = record;
    rememberTrack(record);

    if (sc.widget) {
      sc.playing = false;
      try { sc.widget.pause(); } catch (e) {}
    }
    stopScTimer();
    sc.position = 0;

    setTrackText();
    applyCover(record.art || gradientCover(record.title));
    $('seek').max = String(record.duration || 1);
    $('seek').value = '0';
    setLines([]);
    status('Загружаю поток…');
    renderTracks();
    loadFavorite();
    showView('player');
    updateProgress();
    updatePlayIcon();

    // Текст ищем только после старта звука, чтобы не отнимать канал у потока
    if (lyricsCleanup) lyricsCleanup();
    var lyricsStarted = false;
    var lyricsTimer = 0;
    function startLyrics() {
      if (lyricsStarted) return;
      lyricsStarted = true;
      clearTimeout(lyricsTimer);
      audio.removeEventListener('playing', startLyrics);
      lyricsCleanup = null;
      loadDirectLyrics(record, token);
    }
    lyricsCleanup = function () {
      clearTimeout(lyricsTimer);
      audio.removeEventListener('playing', startLyrics);
      lyricsCleanup = null;
    };
    audio.addEventListener('playing', startLyrics);
    lyricsTimer = setTimeout(startLyrics, 4000);

    resolveDirectStream(record).then(function (stream) {
      if (token !== state.token) return;
      if (stream.protocol === 'progressive') loadProgressive(stream.url, record);
      else loadHls(stream.url, token, record);

      var next = nextDirectRecord(record.id);
      if (next) prefetchDirect(next);
    }).catch(function (error) {
      if (token !== state.token) return;
      var message = String((error && error.message) || '');
      if (message === 'no stream') {
        status('Этот трек защищён и не играет в браузере');
        toast('Трек с защитой SoundCloud — выбери другой');
        return;
      }
      var offline = message.indexOf('Failed to fetch') >= 0 || message.indexOf('NetworkError') >= 0;
      status(offline ? 'Нет связи со SoundCloud' : 'Не удалось получить поток');
      toast(offline ? 'Проверь интернет и попробуй снова' : 'Этот трек сейчас не отдаётся');
    });
  }

  function directById(id) {
    for (var i = 0; i < direct.view.length; i++) {
      if (direct.view[i].id === id) return direct.view[i];
    }
    for (var j = 0; j < direct.feed.length; j++) {
      if (direct.feed[j].id === id) return direct.feed[j];
    }
    return null;
  }

  function parseFileName(name) {
    var base = String(name || '').replace(/\.[^.]+$/, '').replace(/_+/g, ' ').replace(/\s+/g, ' ').trim();
    var match = base.match(/^(.{2,}?)\s*[-–—]\s*(.+)$/);
    if (match) return { artist: match[1].trim(), title: match[2].trim() };
    return { artist: '', title: base || 'Без названия' };
  }

  function inspectAudio(file) {
    var guess = parseFileName(file.name);
    return new Promise(function (resolve) {
      var url = URL.createObjectURL(file);
      var probe = new Audio();
      var done = false;

      function finish(duration) {
        if (done) return;
        done = true;
        probe.onloadedmetadata = null;
        probe.onerror = null;
        probe.removeAttribute('src');
        URL.revokeObjectURL(url);
        resolve({
          title: guess.title,
          artist: guess.artist,
          duration: isFinite(duration) && duration > 0 ? Math.round(duration) : 0
        });
      }

      probe.preload = 'metadata';
      probe.onloadedmetadata = function () { finish(probe.duration); };
      probe.onerror = function () { finish(0); };
      setTimeout(function () { finish(probe.duration); }, 6000);
      probe.src = url;
    });
  }

  function isAudioFile(file) {
    if (!file) return false;
    return /^audio\//.test(file.type || '') || /\.(mp3|m4a|aac|wav|ogg|oga|opus|flac|weba)$/i.test(file.name || '');
  }

  function addFiles(files) {
    var list = Array.prototype.slice.call(files || []).filter(isAudioFile);
    if (!list.length) { toast('Это не аудиофайлы'); return; }

    toast(list.length === 1 ? 'Добавляю трек…' : 'Добавляю треков: ' + list.length);

    var chain = Promise.resolve();
    var last = null;

    list.forEach(function (file) {
      chain = chain.then(function () {
        return inspectAudio(file).then(function (info) {
          var record = {
            id: 't' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7),
            title: info.title,
            artist: info.artist,
            duration: info.duration,
            blob: file,
            lrc: null,
            addedAt: Date.now()
          };
          return dbPut(record).then(function () {
            state.tracks.push(record);
            last = record;
            renderTracks();
          });
        });
      });
    });

    chain.then(function () {
      renderTracks();
      toast(list.length === 1 ? 'Трек добавлен' : 'Добавлено треков: ' + list.length);
      if (last) loadTrack(last.id, true);
    }).catch(function () {
      toast('Не удалось сохранить трек в браузере');
    });
  }

  function removeTrack(id) {
    dbDel(id).catch(function () {});
    state.tracks = state.tracks.filter(function (track) { return track.id !== id; });
    if (favorites[id]) { delete favorites[id]; saveFavorites(); }
    if (state.currentId === id) playBuiltin(false);
    renderTracks();
    toast('Трек удалён');
  }

  function loadLibrary() {
    return dbAll().then(function (list) {
      list.sort(function (a, b) { return (a.addedAt || 0) - (b.addedAt || 0); });
      state.tracks = list;
      renderTracks();
      renderLibrary();
    }).catch(function () {
      state.tracks = [];
      renderTracks();
      renderLibrary();
    });
  }

  /* ------------------------------- playlists ------------------------------- */

  var PLAYLIST_KEY = 'polaris.playlists';
  var LIB_VIEW_KEY = 'polaris.libview';
  var playlists = [];
  var libState = { tab: 'all', open: null, filter: '', layout: 'grid' };

  function loadPlaylists() {
    var data = null;
    try { data = JSON.parse(localStorage.getItem(ukey(PLAYLIST_KEY)) || '[]'); } catch (e) { data = null; }
    playlists = (Array.isArray(data) ? data : []).filter(function (item) {
      return item && item.id && item.name;
    }).map(function (item) {
      return {
        id: String(item.id),
        name: String(item.name),
        tracks: Array.isArray(item.tracks) ? item.tracks.map(String) : []
      };
    });
    try {
      var layout = localStorage.getItem(ukey(LIB_VIEW_KEY));
      if (layout === 'list' || layout === 'grid') libState.layout = layout;
    } catch (e) {}
  }

  function savePlaylists() {
    try { localStorage.setItem(ukey(PLAYLIST_KEY), JSON.stringify(playlists)); } catch (e) {}
  }

  function saveLibLayout() {
    try { localStorage.setItem(ukey(LIB_VIEW_KEY), libState.layout); } catch (e) {}
  }

  function playlistById(id) {
    for (var i = 0; i < playlists.length; i++) {
      if (playlists[i].id === id) return playlists[i];
    }
    return null;
  }

  function scSoundById(id) {
    for (var i = 0; i < sc.sounds.length; i++) {
      if (sc.sounds[i].id === id) return sc.sounds[i];
    }
    return null;
  }

  function libTrackById(id) {
    if (!id) return null;
    if (id === 'builtin') {
      return { id: 'builtin', title: BUILTIN.title, artist: BUILTIN.artist, duration: BUILTIN.duration, builtin: true };
    }
    var record = directById(id);
    if (record) return record;
    record = scSoundById(id);
    if (record) return record;
    record = libraryTrack(id);
    if (record) return record;
    return cachedTrack(id);
  }

  /* ---------------------------- track snapshots ---------------------------- */

  // Плейлисты хранят только id, поэтому запоминаем название/обложку/исполнителя.
  // Иначе трек из поиска исчезал бы из плейлиста после перезагрузки.
  var TRACK_CACHE_KEY = 'polaris.trackcache';
  var trackCache = {};

  function loadTrackCache() {
    try { trackCache = JSON.parse(localStorage.getItem(ukey(TRACK_CACHE_KEY)) || '{}') || {}; } catch (e) { trackCache = {}; }
    if (typeof trackCache !== 'object' || Array.isArray(trackCache)) trackCache = {};
  }

  function saveTrackCache() {
    try { localStorage.setItem(ukey(TRACK_CACHE_KEY), JSON.stringify(trackCache)); } catch (e) {}
  }

  function rememberTrack(track) {
    // Треки официального виджета не кэшируем: без подключения SoundCloud их не открыть.
    if (!track || !track.id || track.builtin || !track.direct) return;
    var entry = {
      id: track.id,
      sid: track.sid || null,
      title: track.title || 'Без названия',
      artist: track.artist || '',
      duration: track.duration || 0,
      art: track.art || '',
      permalink: track.permalink || '',
      direct: true,
      at: Date.now()
    };
    trackCache[entry.id] = entry;

    var keys = Object.keys(trackCache);
    if (keys.length > 300) {
      keys.sort(function (a, b) { return (trackCache[a].at || 0) - (trackCache[b].at || 0); });
      keys.slice(0, keys.length - 300).forEach(function (key) { delete trackCache[key]; });
    }
    saveTrackCache();
  }

  function cachedTrack(id) {
    var entry = trackCache[id];
    if (!entry) return null;
    return {
      id: entry.id,
      sid: entry.sid,
      title: entry.title,
      artist: entry.artist,
      duration: entry.duration,
      art: entry.art,
      permalink: entry.permalink,
      direct: true,
      cached: true
    };
  }

  function songsWord(count) {
    var n = Math.abs(Number(count) || 0) % 100;
    var n1 = n % 10;
    if (n > 10 && n < 20) return count + ' песен';
    if (n1 === 1) return count + ' песня';
    if (n1 >= 2 && n1 <= 4) return count + ' песни';
    return count + ' песен';
  }

  function libFavoriteTracks() {
    var list = [];
    Object.keys(favorites).forEach(function (id) {
      var track = libTrackById(id);
      if (track) list.push(track);
    });
    return list;
  }

  function libPlaylistTracks(playlist) {
    var list = [];
    if (!playlist) return list;
    playlist.tracks.forEach(function (id) {
      var track = libTrackById(id);
      if (track) list.push(track);
    });
    return list;
  }

  function libArtistTracks(name) {
    var needle = String(name || '').toLowerCase();
    var seen = {};
    var list = [];
    function take(track) {
      if (!track || seen[track.id]) return;
      if (String(track.artist || '').toLowerCase() !== needle) return;
      seen[track.id] = 1;
      list.push(track);
    }
    libFavoriteTracks().forEach(take);
    state.tracks.forEach(take);
    playlists.forEach(function (playlist) { libPlaylistTracks(playlist).forEach(take); });
    return list;
  }

  function libArtists() {
    var seen = {};
    var list = [];
    function take(track) {
      var name = String((track && track.artist) || '').trim();
      if (!name) return;
      var key = name.toLowerCase();
      if (!seen[key]) {
        seen[key] = { name: name, tracks: [] };
        list.push(seen[key]);
      }
      if (seen[key].tracks.indexOf(track.id) < 0) seen[key].tracks.push(track);
    }
    libFavoriteTracks().forEach(take);
    state.tracks.forEach(take);
    playlists.forEach(function (playlist) { libPlaylistTracks(playlist).forEach(take); });
    list.sort(function (a, b) { return a.name.localeCompare(b.name, 'ru'); });
    return list;
  }

  var LIB_ICONS = {
    heart: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.1s-7.5-4.5-7.5-9.5A4.35 4.35 0 0 1 12 7.5a4.35 4.35 0 0 1 7.5 3.1c0 5-7.5 9.5-7.5 9.5z"/></svg>',
    folder: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 7.3v10.4a1.8 1.8 0 0 0 1.8 1.8h13.4a1.8 1.8 0 0 0 1.8-1.8V8.6a1.8 1.8 0 0 0-1.8-1.8h-6.6L9.6 5H5.3a1.8 1.8 0 0 0-1.8 1.8z"/><circle cx="11.9" cy="14.5" r="1.9"/><path d="M13.8 14.5v-4.4l3.2-1v4.4"/></svg>',
    note: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9.3 17.6V6.7l9.4-1.9v10.6"/><circle cx="6.7" cy="17.8" r="2.6"/><circle cx="16.1" cy="15.5" r="2.6"/></svg>'
  };

  function libCardHtml(item) {
    var art = '';
    if (item.kind === 'fav') {
      art = '<div class="lib-art lib-art-fav">' + LIB_ICONS.heart + '</div>';
    } else if (item.kind === 'local') {
      art = '<div class="lib-art lib-art-local">' + LIB_ICONS.folder + '</div>';
    } else if (item.kind === 'artist') {
      art = '<div class="lib-art lib-art-artist">' + esc(String(item.name).charAt(0).toUpperCase()) + '</div>';
    } else {
      art = '<div class="lib-art lib-art-cover" style="background-image:linear-gradient(rgba(0,0,0,.3),rgba(0,0,0,.55)),url(\'' +
        gradientCover(item.id + item.name) + '\')">' + LIB_ICONS.note + '</div>';
    }

    var key = item.kind;
    if (item.kind === 'playlist') key = 'pl:' + item.id;
    if (item.kind === 'artist') key = 'artist:' + encodeURIComponent(item.name);

    return '<article class="lib-card" data-lib="' + esc(key) + '" role="button" tabindex="0">' +
      art +
      '<div class="lib-card-text">' +
      '<div class="lib-card-name">' + esc(item.name) + '</div>' +
      '<div class="lib-card-sub">' + songsWord(item.count) + '</div>' +
      '</div></article>';
  }

  function libCardsItems() {
    var items = [];
    if (libState.tab === 'all' || libState.tab === 'playlists') {
      if (libState.tab === 'all') {
        items.push({ kind: 'fav', name: 'Понравившиеся', count: libFavoriteTracks().length });
        items.push({ kind: 'local', name: 'На устройстве', count: state.tracks.length });
      }
      playlists.forEach(function (playlist) {
        items.push({ kind: 'playlist', id: playlist.id, name: playlist.name, count: libPlaylistTracks(playlist).length });
      });
    }
    if (libState.tab === 'artists') {
      libArtists().forEach(function (artist) {
        items.push({ kind: 'artist', name: artist.name, count: artist.tracks.length });
      });
    }
    return items;
  }

  function libEmptyText() {
    if (libState.filter) return 'Ничего не нашлось.';
    if (libState.tab === 'albums') return 'Альбомов пока нет.';
    if (libState.tab === 'artists') return 'Исполнителей пока нет — добавь треки в избранное или на устройство.';
    if (libState.tab === 'playlists') return 'Плейлистов пока нет. Нажми «Создать плейлист».';
    return 'Библиотека пуста.';
  }

  function renderLibrary() {
    var cards = $('libCards');
    if (!cards) return;

    Array.prototype.forEach.call($('libTabs').querySelectorAll('.lib-tab'), function (tab) {
      tab.classList.toggle('active', tab.getAttribute('data-tab') === libState.tab);
    });
    $('libGrid').classList.toggle('active', libState.layout === 'grid');
    $('libRows').classList.toggle('active', libState.layout === 'list');
    cards.classList.toggle('list', libState.layout === 'list');

    if (libState.open) {
      cards.classList.add('hidden');
      $('libEmpty').classList.add('hidden');
      $('libOpen').classList.remove('hidden');
      renderLibOpen();
      return;
    }

    $('libOpen').classList.add('hidden');
    var needle = String(libState.filter || '').toLowerCase();
    var items = libCardsItems().filter(function (item) {
      return !needle || String(item.name).toLowerCase().indexOf(needle) >= 0;
    });

    if (!items.length) {
      cards.classList.add('hidden');
      $('libEmpty').classList.remove('hidden');
      $('libEmpty').textContent = libEmptyText();
      return;
    }

    $('libEmpty').classList.add('hidden');
    cards.classList.remove('hidden');
    cards.innerHTML = items.map(libCardHtml).join('');
  }

  function renderLibOpen() {
    var open = libState.open;
    if (!open) { renderLibrary(); return; }

    var title = '';
    var tracks = [];
    var playlist = null;

    if (open.kind === 'fav') {
      title = 'Понравившиеся';
      tracks = libFavoriteTracks();
    } else if (open.kind === 'local') {
      title = 'На устройстве';
      tracks = state.tracks.slice();
    } else if (open.kind === 'playlist') {
      playlist = playlistById(open.id);
      if (!playlist) { libState.open = null; renderLibrary(); return; }
      title = playlist.name;
      tracks = libPlaylistTracks(playlist);
    } else if (open.kind === 'artist') {
      title = open.name;
      tracks = libArtistTracks(open.name);
    }

    var needle = String(libState.filter || '').toLowerCase();
    if (needle) {
      tracks = tracks.filter(function (track) {
        return (String(track.title) + ' ' + String(track.artist || '')).toLowerCase().indexOf(needle) >= 0;
      });
    }

    $('libOpenHead').innerHTML =
      '<button class="lib-back" id="libBack">← Библиотека</button>' +
      '<h2 class="lib-open-title">' + esc(title) + '</h2>' +
      '<span class="lib-open-sub">' + songsWord(tracks.length) + '</span>' +
      (playlist ? '<button class="sc-ghost" id="libDelPl">Удалить плейлист</button>' : '');

    var box = $('libTracks');
    var note = $('libOpenEmpty');
    if (!tracks.length) {
      box.innerHTML = '';
      box.classList.add('hidden');
      if (!note) {
        note = document.createElement('div');
        note.className = 'lib-empty';
        note.id = 'libOpenEmpty';
        $('libOpen').appendChild(note);
      }
      note.textContent = playlist
        ? 'Плейлист пуст. Вернись в библиотеку и добавь треки кнопкой «+» у нужного трека.'
        : 'Здесь пока пусто.';
      note.classList.remove('hidden');
      return;
    }

    if (note) note.classList.add('hidden');
    box.classList.remove('hidden');
    box.innerHTML = tracks.map(function (track) { return libRow(track, playlist); }).join('');
  }

  function libRow(track, playlist) {
    var playing = track.id === state.currentId ? ' playing' : '';
    var attrs = ' data-id="' + esc(track.id) + '"';
    if (track.direct) attrs += ' data-direct="1"';
    else if (track.url && typeof track.scIndex === 'number') attrs += ' data-sc="' + track.scIndex + '"';

    var remove = playlist
      ? '<button class="track-more" data-unlink="' + esc(track.id) + '" title="Убрать из плейлиста">✕</button>'
      : '';
    var add = '<button class="track-add" data-addto="' + esc(track.id) + '" title="Добавить в плейлист">' +
      '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>' +
      '</button>';

    return '<div class="track-row' + playing + '"' + attrs + ' role="button" tabindex="0">' +
      '<img class="track-thumb" src="' + coverFor(track) + '" alt="">' +
      '<div class="track-meta">' +
      '<div class="track-name">' + esc(track.title) + '</div>' +
      '<div class="track-sub">' + esc(track.artist || 'Без исполнителя') + '</div>' +
      '</div>' +
      '<span class="track-dur">' + (track.duration ? formatTime(track.duration) : '—') + '</span>' +
      remove + add +
      '</div>';
  }

  function playLibTrack(id) {
    var track = libTrackById(id);
    if (!track) { toast('Трек больше недоступен'); return; }
    playAnyTrack(track);
  }

  function openLibrary() {
    showView('home');
    $('homeScroll').classList.add('hidden');
    $('libraryScroll').classList.remove('hidden');
    $('railHome').classList.remove('active');
    $('railLibrary').classList.add('active');
    $('libraryScroll').scrollTop = 0;
    renderLibrary();
  }

  function openHomeScreen() {
    $('libraryScroll').classList.add('hidden');
    $('homeScroll').classList.remove('hidden');
    $('railLibrary').classList.remove('active');
    $('railHome').classList.add('active');
    $('homeScroll').scrollTop = 0;
  }

  function createPlaylist(name) {
    var playlist = {
      id: 'p' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6),
      name: name,
      tracks: []
    };
    playlists.push(playlist);
    savePlaylists();
    return playlist;
  }

  function addToPlaylist(playlistId, trackId) {
    var playlist = playlistById(playlistId);
    if (!playlist) return;
    if (playlist.tracks.indexOf(trackId) >= 0) { toast('Уже в плейлисте'); return; }
    rememberTrack(libTrackById(trackId));
    playlist.tracks.push(trackId);
    savePlaylists();
    toast('Добавлено в «' + playlist.name + '»');
    renderLibrary();
  }

  function removeFromPlaylist(playlistId, trackId) {
    var playlist = playlistById(playlistId);
    if (!playlist) return;
    playlist.tracks = playlist.tracks.filter(function (id) { return id !== trackId; });
    savePlaylists();
    renderLibOpen();
    toast('Убрано из плейлиста');
  }

  function deletePlaylist(id) {
    var playlist = playlistById(id);
    if (!playlist) return;
    if (!window.confirm('Удалить плейлист «' + playlist.name + '»?')) return;
    playlists = playlists.filter(function (item) { return item.id !== id; });
    savePlaylists();
    libState.open = null;
    renderLibrary();
    toast('Плейлист удалён');
  }

  var addMenu = null;

  function closeAddMenu() {
    if (!addMenu) return;
    addMenu.remove();
    addMenu = null;
    document.removeEventListener('pointerdown', closeAddMenuOutside, true);
  }

  function closeAddMenuOutside(event) {
    if (!addMenu) return;
    if (event.target.closest('.lib-menu') || event.target.closest('[data-addto]')) return;
    closeAddMenu();
  }

  function openAddMenu(anchor, trackId) {
    closeAddMenu();
    var menu = document.createElement('div');
    menu.className = 'lib-menu';

    var items = playlists.map(function (playlist) {
      return '<button data-pl="' + esc(playlist.id) + '">' + esc(playlist.name) + '</button>';
    }).join('');
    if (!playlists.length) items = '<div class="lib-menu-note">Плейлистов пока нет</div>';

    menu.innerHTML = items + '<button class="lib-menu-new" data-newpl="1">+ Новый плейлист</button>';
    document.body.appendChild(menu);

    var box = anchor.getBoundingClientRect();
    var width = menu.offsetWidth;
    var height = menu.offsetHeight;
    var left = Math.min(window.innerWidth - width - 12, box.right - width);
    var top = box.bottom + 6;
    if (top + height > window.innerHeight - 12) top = Math.max(12, box.top - height - 6);
    menu.style.left = Math.max(12, left) + 'px';
    menu.style.top = top + 'px';

    menu.addEventListener('click', function (event) {
      var playlistBtn = event.target.closest('[data-pl]');
      if (playlistBtn) {
        addToPlaylist(playlistBtn.getAttribute('data-pl'), trackId);
        closeAddMenu();
        return;
      }
      if (event.target.closest('[data-newpl]')) {
        closeAddMenu();
        askPlaylistName().then(function (name) {
          if (!name) return;
          var playlist = createPlaylist(name);
          addToPlaylist(playlist.id, trackId);
          renderLibrary();
        });
      }
    });

    addMenu = menu;
    document.addEventListener('pointerdown', closeAddMenuOutside, true);
  }

  function askPlaylistName() {
    return new Promise(function (resolve) {
      var box = $('dialog');
      var input = $('dialogInput');
      $('dialogTitle').textContent = 'Новый плейлист';
      input.value = '';
      box.classList.remove('hidden');
      input.focus();

      function finish(value) {
        box.classList.add('hidden');
        $('dialogOk').removeEventListener('click', onOk);
        $('dialogCancel').removeEventListener('click', onCancel);
        input.removeEventListener('keydown', onKey);
        box.removeEventListener('pointerdown', onBackdrop);
        resolve(value);
      }
      function onOk() {
        var name = input.value.trim();
        finish(name || null);
      }
      function onCancel() { finish(null); }
      function onKey(event) {
        if (event.key === 'Enter') { event.preventDefault(); event.stopPropagation(); onOk(); }
        if (event.key === 'Escape') { event.preventDefault(); event.stopPropagation(); onCancel(); }
      }
      function onBackdrop(event) { if (event.target === box) onCancel(); }

      $('dialogOk').addEventListener('click', onOk);
      $('dialogCancel').addEventListener('click', onCancel);
      input.addEventListener('keydown', onKey);
      box.addEventListener('pointerdown', onBackdrop);
    });
  }

  /* ------------------------------ play queue ------------------------------ */

  var playQueue = [];

  function playAnyTrack(track) {
    if (!track) return;
    if (track.builtin) { playBuiltin(true); return; }
    if (track.direct) { playDirect(track); return; }
    if (track.url && typeof track.scIndex === 'number') { loadScTrack(track.scIndex); return; }
    loadTrack(track.id, true);
  }

  function takeQueuedTrack() {
    while (playQueue.length) {
      var id = playQueue.shift();
      var track = libTrackById(id);
      if (track) return track;
    }
    return null;
  }

  function queueTrack(track, front) {
    if (!track || !track.id) return;
    if (front) playQueue.unshift(track.id);
    else playQueue.push(track.id);
    toast(front ? 'Заиграет следующим' : 'Добавлено в очередь');
  }

  function startStation(track) {
    if (!track) return;
    playQueue = [];
    var artist = String(track.artist || '').trim().toLowerCase();
    var seen = {};
    seen[track.id] = 1;

    function pick(item) {
      if (!item || !item.direct || item.playable === false || seen[item.id]) return;
      seen[item.id] = 1;
      playQueue.push(item.id);
    }

    var pool = direct.feed.concat(direct.view);
    if (artist) {
      pool.forEach(function (item) {
        if (String(item.artist || '').toLowerCase().indexOf(artist) >= 0) pick(item);
      });
    }
    pool.forEach(pick);
    playQueue = playQueue.slice(0, 20);

    playAnyTrack(track);
    if (artist) toast('Станция: ' + track.artist + ' · ' + playQueue.length + ' треков');
    else toast('Станция запущена');
  }

  function toggleFavoriteById(id) {
    if (!id) return;
    var liked = !!favorites[id];
    if (liked) delete favorites[id];
    else {
      favorites[id] = 1;
      rememberTrack(libTrackById(id));
    }
    saveFavorites();
    if (state.currentId === id) {
      state.favorite = !liked;
      updateLike();
    }
