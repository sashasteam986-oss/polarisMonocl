      var item = event.target.closest('[data-page-btn]');
      if (item) { showSettingsPage(item.getAttribute('data-page-btn')); return; }
      if (event.target.closest('#logoutItem')) logout();
    });
    $('setSearch').addEventListener('input', filterSettings);
    $('settingsModal').addEventListener('click', function (event) {
      var toggle = event.target.closest('.set-toggle[data-set]');
      if (toggle) {
        var key = toggle.getAttribute('data-set');
        writeSetting(key, !readSettings()[key]);
        syncSettingControls();
        return;
      }
      var option = event.target.closest('.set-seg[data-set] button');
      if (option) {
        writeSetting(option.parentNode.getAttribute('data-set'), option.getAttribute('data-value'));
        syncSettingControls();
        return;
      }
      if (event.target.closest('#clearCacheBtn')) {
        try { localStorage.removeItem(FEED_CACHE); } catch (e) {}
        refreshStorage();
        var btn = $('clearCacheBtn');
        btn.textContent = 'Очищено';
        setTimeout(function () { btn.textContent = 'Очистить'; }, 1500);
      }
    });
  }

  function handleSignedOut() {
    try { audio.pause(); } catch (e) {}
    try { if (scActive()) sc.widget.pause(); } catch (e) {}
    closeSettings();
    ['loginEmail', 'loginPass', 'regNick', 'regEmail', 'regPass', 'regPass2'].forEach(function (id) { $(id).value = ''; });
    switchAuthTab('login');
  }

  function applySession(session) {
    if (session && session.user) {
      // другой пользователь в уже запущенном приложении: перезапуск подтянет его данные
      if (appStarted && startedFor !== session.user.id) { location.reload(); return; }
      authUser = session.user;
      claimLegacyData(authUser.id);
      storageScope = authUser.id;
      startedFor = authUser.id;
      renderSettingsUser();
      showAuth('app');
      startApp();
      return;
    }
    if (authUser) handleSignedOut();
    authUser = null;
    showAuth('form');
  }

  function submitLogin(event) {
    event.preventDefault();
    if (authBusy) return;
    var email = $('loginEmail').value.trim();
    var password = $('loginPass').value;
    if (!email || !password) { authMessage('Введите почту и пароль'); return; }
    authMessage('');
    setAuthBusy(true);
    authClient.auth.signInWithPassword({ email: email, password: password }).then(function (res) {
      setAuthBusy(false);
      if (res.error) { authMessage(authErrorText(res.error)); return; }
      $('loginPass').value = '';
      applySession(res.data && res.data.session);
    }, function (error) {
      setAuthBusy(false);
      authMessage(authErrorText(error));
    });
  }

  function submitRegister(event) {
    event.preventDefault();
    if (authBusy) return;
    var nickname = $('regNick').value.trim();
    var email = $('regEmail').value.trim();
    var password = $('regPass').value;
    var repeat = $('regPass2').value;
    if (nickname.length < 2) { authMessage('Никнейм должен быть не короче 2 символов'); return; }
    if (!email) { authMessage('Введите электронную почту'); return; }
    if (password.length < MIN_PASSWORD) { authMessage('Пароль должен быть не короче ' + MIN_PASSWORD + ' символов'); return; }
    if (password !== repeat) { authMessage('Пароли не совпадают'); return; }
    authMessage('');
    setAuthBusy(true);
    authClient.auth.signUp({ email: email, password: password, options: { data: { username: nickname } } }).then(function (res) {
      setAuthBusy(false);
      if (res.error) { authMessage(authErrorText(res.error)); return; }
      var user = res.data && res.data.user;
      // при включённом подтверждении почты Supabase не отдаёт ошибку для занятого адреса,
      // но возвращает пользователя без identities
      if (user && user.identities && user.identities.length === 0) {
        authMessage('Аккаунт с такой почтой уже существует');
        return;
      }
      if (res.data && res.data.session) {
        $('regPass').value = '';
        $('regPass2').value = '';
        applySession(res.data.session);
        return;
      }
      switchAuthTab('login');
      $('loginEmail').value = email;
      authMessage('Мы отправили письмо на ' + email + '. Подтвердите почту и войдите.', 'ok');
    }, function (error) {
      setAuthBusy(false);
      authMessage(authErrorText(error));
    });
  }

  function logout() {
    authClient.auth.signOut().then(function (res) {
      if (res && res.error) return authClient.auth.signOut({ scope: 'local' });
    }).then(function () {
      applySession(null);
    }, function () {
      applySession(null);
    });
  }

  function initAuth() {
    $('authCard').addEventListener('click', function (event) {
      var tab = event.target.closest('[data-auth-tab]');
      if (tab) { switchAuthTab(tab.getAttribute('data-auth-tab')); return; }
      var eye = event.target.closest('[data-eye]');
      if (eye) {
        var input = eye.parentNode.querySelector('input');
        var show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        eye.classList.toggle('shown', show);
        eye.title = show ? 'Скрыть пароль' : 'Показать пароль';
      }
    });
    $('loginForm').addEventListener('submit', submitLogin);
    $('registerForm').addEventListener('submit', submitRegister);
    $('logoutBtn').addEventListener('click', logout);
    $('settingsClose').addEventListener('click', closeSettings);
    $('settingsModal').addEventListener('click', function (event) {
      if (event.target === $('settingsModal')) closeSettings();
    });

    if (!window.supabase || !window.supabase.createClient) {
      showAuth('form');
      authMessage('Не удалось загрузить Supabase. Проверьте интернет и обновите страницу');
      return;
    }
    authClient = window.supabase.createClient(SUPABASE_CONFIG.url, SUPABASE_CONFIG.key);
    authClient.auth.onAuthStateChange(function (event, session) { applySession(session); });
    authClient.auth.getSession().then(function (res) {
      applySession(res.data && res.data.session);
    }, function () {
      applySession(null);
    });
  }

  /* --------------------- автообновление (GitHub Pages) --------------------- */
  // Файл лежит на хостинге: раз в минуту проверяем, не выложена ли новая версия.
  // Сравниваем дату загруженной страницы с датой файла на сервере; если сервер
  // новее — один раз перезагружаемся с обходом кэша. Для file:// проверка молчит.
  var UPDATE_EVERY = 60 * 1000;
  var updateBusy = false;
  var updateStarted = false;

  function checkUpdate() {
    if (location.protocol !== 'http:' && location.protocol !== 'https:') return;
    if (updateBusy) return;
    updateBusy = true;

    fetch(location.pathname + '?polaris=' + Date.now(), { method: 'HEAD', cache: 'no-store' })
      .then(function (res) {
        updateBusy = false;
        if (!res.ok) return;

        var remote = res.headers.get('last-modified');
        var loaded = document.lastModified;
        if (!remote || !loaded) return;

        var remoteAt = Date.parse(remote);
        var loadedAt = Date.parse(loaded);
        if (!remoteAt || !loadedAt) return;
        if (remoteAt <= loadedAt + 1500) return;

        // Одна попытка на версию в рамках вкладки — без циклов перезагрузки
        var guard = 'polaris.upd.' + remoteAt;
        try {
          if (sessionStorage.getItem(guard)) return;
          sessionStorage.setItem(guard, '1');
        } catch (e) {}

        location.replace(location.pathname + '?v=' + remoteAt + location.hash);
      })
      .catch(function () { updateBusy = false; });
  }

  function startUpdates() {
    if (updateStarted) return;
    if (location.protocol !== 'http:' && location.protocol !== 'https:') return;
    updateStarted = true;
    setTimeout(checkUpdate, 5000);
    setInterval(checkUpdate, UPDATE_EVERY);
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) checkUpdate();
    });
    window.addEventListener('online', checkUpdate);
  }

  initSettings();
  initAuth();
})();
</script>
<script>
/* Мост для десктопной оболочки. В обычном браузере window.polarisDesktop нет, и скрипт ничего не делает. */
(function () {
  var d = window.polarisDesktop;
  if (!d) return;
  var $ = function (id) { return document.getElementById(id); };
  var last = '';
  function snapshot() {
    var img = $('npSideCoverImg');
    var seek = $('seek');
    var max = seek ? parseFloat(seek.max) : 0;
    return {
      title: ($('npSideName') || {}).textContent || '',
      artist: ($('npSideArtist') || {}).textContent || '',
      cover: img && !img.classList.contains('hidden') ? img.src : '',
      playing: document.body.classList.contains('is-playing'),
      progress: max > 0 ? parseFloat(seek.value) / max : 0
    };
  }
  setInterval(function () {
    var s = snapshot();
    var key = JSON.stringify(s);
    if (key !== last) { last = key; d.sendState(s); }
  }, 500);
  d.onCommand(function (cmd) {
    var id = { toggle: 'playBtn', back: 'backBtn', forward: 'fwdBtn' }[cmd];
    var el = id && $(id);
    if (el) el.click();
  });
})();
</script>
