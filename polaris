  // Плавно подводим фактическую громкость к нужной: ~90 мс на подход
  function stepVolume(now) {
    var target = state.muted ? 0 : state.volume;
    var dt = volLastAt ? Math.min(120, now - volLastAt) : 16;
    volLastAt = now;
    var diff = target - volCurrent;
    if (Math.abs(diff) < 0.0025) {
      if (volCurrent !== target) {
        volCurrent = target;
        audio.volume = target;
      }
      return;
    }
    volCurrent += diff * (1 - Math.exp(-dt / 90));
    audio.volume = Math.min(1, Math.max(0, volCurrent));
  }

